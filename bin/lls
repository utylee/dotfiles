def _tail_file(path: Path, lines: int) -> None:
    if not path.exists():
        print(f"No log file: {path}")
        return

    with path.open("rb") as f:
        try:
            f.seek(0, os.SEEK_END)
            end = f.tell()
            block = 4096
            data = b""

            while end > 0 and data.count(b"\n") <= lines:
                read_size = min(block, end)
                end -= read_size
                f.seek(end)
                data = f.read(read_size) + data
                if end == 0:
                    break

            text = data.decode("utf-8", errors="replace")
        except Exception:
            text = path.read_text(encoding="utf-8", errors="replace")

    out_lines = text.splitlines()[-lines:]
    if out_lines:
        print("\n".join(out_lines))

def _follow_file(path: Path, tail_lines: int = 30) -> int:
    if not path.exists():
        print(f"No log file: {path}")
        return 1

    with path.open("r", encoding="utf-8", errors="replace") as f:
        if tail_lines > 0:
            lines = f.readlines()
            for line in lines[-tail_lines:]:
                print(line, end="")
            sys.stdout.flush()

        try:
            while True:
                line = f.readline()
                if line:
                    print(line, end="")
                    sys.stdout.flush()
                else:
                    time.sleep(0.2)
        except KeyboardInterrupt:
            return 130


