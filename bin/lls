def cmd_status(args: argparse.Namespace, config: Dict[str, Any], models: List[ModelEntry]) -> int:
    ensure_state_dir()
    active = get_active_model_id()
    rows: List[Tuple[str, int, int, str, str, str]] = []

    for sf in sorted(RUN_DIR.glob("slot-*.json")):
        st = load_state(sf)
        if not st:
            continue

        pid = int(st.get("pid", -1))
        if not pid_alive(pid):
            sf.unlink(missing_ok=True)
            continue

        model_id = str(st.get("model_id", "<unknown>"))
        slot = int(st.get("slot", 1))
        port = int(st.get("port", config.get("base_port", BUILTIN_DEFAULTS.get("port", 8080)) + (slot - 1)))
        log_path = str(st.get("log", "-"))

        rows.append((
            "*" if active == model_id else " ",
            slot,
            port,
            model_id,
            str(pid),
            log_path,
        ))

    if args.ids:
        for _, _, _, model_id, _, _ in rows:
            print(model_id)
        return 0

    if not rows:
        print("No running models")
        return 0

    w_model = max(len(r[3]) for r in rows)
    w_slot = max(len(str(r[1])) for r in rows)
    w_port = max(len(str(r[2])) for r in rows)
    for mark, slot, port, model_id, pid, log_path in rows:
        print(
            f"{mark} slot={slot:<{w_slot}}  port={port:<{w_port}}  "
            f"{model_id:<{w_model}}  pid={pid:<8}  running  log={log_path}"
        )
    return 0

