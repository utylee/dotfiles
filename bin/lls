def _resolve_log_target(args: argparse.Namespace, config: Dict[str, Any], models: List[ModelEntry]) -> Dict[str, Any]:
    rows = find_running_slot_states()
    if not rows:
        raise SystemExit("No running models")

    model_arg = getattr(args, "model", None)
    slot_arg = None
    if model_arg and str(model_arg).isdigit():
        slot_arg = int(model_arg)
        model_arg = None

    if slot_arg is not None:
        for st in rows:
            if int(st.get("slot", 1)) == slot_arg:
                return st
        raise SystemExit(f"slot {slot_arg} not found")

    if model_arg:
        for st in rows:
            if st.get("model_id") == model_arg:
                return st
        raise SystemExit(f"Model not running: {model_arg}")

    if len(rows) == 1:
        return rows[0]

    lines: List[str] = []
    for st in rows:
        slot = int(st.get("slot", 1))
        port = int(st.get("port", config.get("base_port", BUILTIN_DEFAULTS.get("port", 8080)) + (slot - 1)))
        model_id = str(st.get("model_id", ""))
        pid = str(st.get("pid", "-"))
        lines.append(f"slot={slot}	port={port}	pid={pid}	{model_id}")

    picked = run_fzf(lines, prompt="log> ")
    if not picked:
        raise SystemExit(1)
    m = re.search(r"slot=(\d+)", picked)
    if not m:
        raise SystemExit(1)
    wanted_slot = int(m.group(1))
    for st in rows:
        if int(st.get("slot", 1)) == wanted_slot:
            return st
    raise SystemExit(1)


def cmd_log(args: argparse.Namespace, config: Dict[str, Any], models: List[ModelEntry]) -> int:
    ensure_state_dir()
    state = _resolve_log_target(args, config, models)

    path_str = state.get("log") or state.get("log_path")
    path = Path(path_str) if path_str else None
    if not path:
        print("No log file recorded for selected model")
        return 1

    _tail_file(path, args.lines)
    if args.follow:
        return _follow_file(path)
    return 0

def cmd_action(args: argparse.Namespace, config: Dict[str, Any], models: List[ModelEntry]) -> int:
    action = run_action_picker()
    if not action:
        return 1
    if action == "start":
        ns = argparse.Namespace(slot_or_model=None, model=None, port=None, ctx=None, detach=False, lines=30)
        return cmd_start(ns, config, models)
    if action == "stop":
        ns = argparse.Namespace(model=None, all=False, active=True, force=False)
        return cmd_stop(ns, config, models)
    if action == "status":
        ns = argparse.Namespace()
        return cmd_status(ns, config, models)
    if action == "log":
        ns = argparse.Namespace(model=None, follow=True, lines=30)
        return cmd_log(ns, config, models)
    if action == "show-profile":
        ns = argparse.Namespace(model=None, port=None)
        return cmd_show_profile(ns, config, models)
    if action == "pick":
        ns = argparse.Namespace()
        return cmd_pick(ns, config, models)
    return 1


# -----------------------------
# CLI
# -----------------------------

def load_main_config(path: Path) -> Dict[str, Any]:
    if not path.exists():
        return {}
    return load_jsonc(path)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="lls", description="Local LLM launcher/manager")
    p.add_argument("--config", default=str(DEFAULT_CONFIG), help="Path to config.jsonc")
    p.add_argument("--models-dir", default=os.environ.get("LLS_MODELS_DIR"), help="Override models dir")

    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("list", help="List discovered models")
    sp.set_defaults(func=cmd_list)
    sp.add_argument("--ids", action="store_true", help="Print model IDs only")

    sp = sub.add_parser("pick", help="Pick a model via fzf and print it")
    sp.set_defaults(func=cmd_pick)

    sp = sub.add_parser("action", help="fzf action menu")
    sp.set_defaults(func=cmd_action)

    sp = sub.add_parser("show-profile", help="Show resolved config/profile for a model")
    sp.add_argument("model", nargs="?", help="publisher/model, alias, or fuzzy text")
    sp.add_argument("--port", type=int)
    sp.set_defaults(func=cmd_show_profile)

    sp = sub.add_parser("start", help="Start a model server")
    sp.add_argument("slot_or_model", nargs="?", help="slot number or publisher/model, alias, or fuzzy text")
    sp.add_argument("model", nargs="?", help="publisher/model, alias, or fuzzy text when slot is provided")
    sp.add_argument("--port", type=int)
    sp.add_argument("--ctx", type=int)
    sp.add_argument("-d", "--detach", action="store_true", help="Start and return immediately")
    sp.add_argument("-n", "--lines", type=int, default=30, help="Initial log lines before follow")
    sp.set_defaults(func=cmd_start)

    sp = sub.add_parser("stop", help="Stop a running model")
    sp.add_argument("model", nargs="?", help="publisher/model, alias, or fuzzy text")
    sp.add_argument("--all", action="store_true")
    sp.add_argument("--active", action="store_true")
    sp.add_argument("--force", action="store_true")
    sp.set_defaults(func=cmd_stop)

    sp = sub.add_parser("status", help="Show running models")
    sp.set_defaults(func=cmd_status)
    sp.add_argument("--ids", action="store_true", help="Print running model IDs only")

    sp = sub.add_parser("log", help="Show or follow logs")
    sp.add_argument("model", nargs="?", help="publisher/model, alias, or fuzzy text")
    sp.add_argument("-f", "--follow", action="store_true", help="Follow log output")
    sp.add_argument("-n", "--lines", type=int, default=30, help="Tail last N lines first")
    sp.set_defaults(func=cmd_log)

    return p


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    config_path = Path(args.config).expanduser()
    config = load_main_config(config_path)

    models_dir = args.models_dir or config.get("models_dir") or os.environ.get("LLS_MODELS_DIR")
    if not models_dir:
        raise SystemExit("models_dir not set. Use --models-dir, LLS_MODELS_DIR, or config.jsonc")

    models = discover_models(Path(models_dir).expanduser())
    return args.func(args, config, models)


if __name__ == "__main__":
    raise SystemExit(main())

