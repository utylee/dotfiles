#!/usr/bin/env python3
"""
lls.py

A model launcher/manager for local llama.cpp, MLX-VLM, and oMLX server backends.

New model layout:
  $LLS_MODELS_DIR/<publisher>/<model>/

Recommended contents per model dir:
  metadata.json / metadata.jsonc

llama.cpp:
  one or more *.gguf model files
  optional mmproj*.gguf
  optional MTP/mtp-*.gguf

MLX-VLM:
  model directory (for example 4-bit/)
  optional draft/MTP directory (for example mtp/)

oMLX:
  MLX-format model directory
  lls exposes only the selected model to oMLX through a per-model symlink staging root

Metadata philosophy:
- Model-local metadata stores recommended defaults for that model.
- ~/.config/lls/config.jsonc stores machine/user overrides.
- Final precedence:
    builtin defaults
    -> model metadata defaults
    -> config defaults
    -> profiles from matching rules
    -> direct rule override
    -> CLI overrides

This script is intentionally self-contained and forgiving with JSONC.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import time
from copy import deepcopy
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Dict, Iterable, List, Optional, Tuple


BUILTIN_DEFAULTS: Dict[str, Any] = {
    "backend": "llama-server",
    "host": "0.0.0.0",
    "port": 8080,
    "ctx": 8192,
    "threads": 8,
    "batch": 2048,
    "ubatch": 512,
    "gpu_layers": -1,
    "extra_args": [],
}

STATE_DIR = Path.home() / ".local/state/lls"
LOG_DIR = STATE_DIR / "log"
RUN_DIR = STATE_DIR / "run"
ACTIVE_FILE = STATE_DIR / "active.json"
DEFAULT_CONFIG = Path.home() / ".config/lls/config.jsonc"
METADATA_FILES = ("metadata.json", "metadata.jsonc")
DEFAULT_LOG_ROTATIONS = 5


# -----------------------------
# JSONC / config helpers
# -----------------------------

def strip_jsonc_comments(text: str) -> str:
    out: List[str] = []
    i = 0
    in_str = False
    escape = False
    while i < len(text):
        ch = text[i]
        nxt = text[i + 1] if i + 1 < len(text) else ""
        if in_str:
            out.append(ch)
            if escape:
                escape = False
            elif ch == "\\":
                escape = True
            elif ch == '"':
                in_str = False
            i += 1
            continue
        if ch == '"':
            in_str = True
            out.append(ch)
            i += 1
            continue
        if ch == "/" and nxt == "/":
            while i < len(text) and text[i] != "\n":
                i += 1
            continue
        if ch == "/" and nxt == "*":
            i += 2
            while i + 1 < len(text) and not (text[i] == "*" and text[i + 1] == "/"):
                i += 1
            i += 2
            continue
        out.append(ch)
        i += 1
    return "".join(out)


def auto_insert_missing_commas(text: str) -> str:
    """
    Very forgiving line-based fixer for JSONC-ish files where a comma is omitted
    between adjacent properties/items.
    Good enough for config files like the user's lls config.
    """
    lines = text.splitlines()
    sig_idx = [i for i, line in enumerate(lines) if line.strip()]
    sig_set = set(sig_idx)

    def next_sig(i: int) -> Optional[int]:
        for j in range(i + 1, len(lines)):
            if j in sig_set:
                return j
        return None

    for i, line in enumerate(lines):
        stripped = line.rstrip()
        core = stripped.strip()
        if not core:
            continue
        if core.endswith(("{", "[", ",", ":")):
            continue
        j = next_sig(i)
        if j is None:
            continue
        next_core = lines[j].strip()
        if next_core.startswith(("}", "]")):
            continue
        if next_core.startswith('"') or next_core.startswith("{") or next_core.startswith("["):
            lines[i] = stripped + ","
    return "\n".join(lines)


def remove_trailing_commas(text: str) -> str:
    return re.sub(r",\s*([}\]])", r"\1", text)


def load_jsonc(path: Path) -> Dict[str, Any]:
    raw = path.read_text(encoding="utf-8")
    cleaned = strip_jsonc_comments(raw)
    cleaned = auto_insert_missing_commas(cleaned)
    cleaned = remove_trailing_commas(cleaned)
    try:
        data = json.loads(cleaned)
    except json.JSONDecodeError as e:
        raise SystemExit(f"Failed to parse {path}: {e}")
    if not isinstance(data, dict):
        raise SystemExit(f"Expected object in {path}")
    return data


# -----------------------------
# Merge helpers
# -----------------------------

def deep_copy_dict(d: Dict[str, Any]) -> Dict[str, Any]:
    return deepcopy(d)


def merge_config(base: Dict[str, Any], overlay: Optional[Dict[str, Any]]) -> Dict[str, Any]:
    if not overlay:
        return base
    out = deep_copy_dict(base)
    for k, v in overlay.items():
        if k == "extra_args_append":
            out.setdefault("extra_args", [])
            out["extra_args"] = list(out.get("extra_args", [])) + list(v)
            continue
        if k == "extra_args_prepend":
            out.setdefault("extra_args", [])
            out["extra_args"] = list(v) + list(out.get("extra_args", []))
            continue
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = merge_config(out[k], v)
        else:
            out[k] = deepcopy(v)
    return out


def slugify(text: str) -> str:
    return re.sub(r"[^a-zA-Z0-9._-]+", "-", text.strip("/ ")).strip("-").lower()


# -----------------------------
# Model discovery
# -----------------------------

@dataclass
class ModelEntry:
    publisher: str
    name: str
    root: Path
    metadata_path: Optional[Path] = None
    metadata: Dict[str, Any] = field(default_factory=dict)

    @property
    def model_id(self) -> str:
        return f"{self.publisher}/{self.name}"

    @property
    def aliases(self) -> List[str]:
        raw = self.metadata.get("aliases", [])
        return [str(x) for x in raw] if isinstance(raw, list) else []

    @property
    def tags(self) -> List[str]:
        raw = self.metadata.get("tags", [])
        return [str(x) for x in raw] if isinstance(raw, list) else []

    @property
    def defaults(self) -> Dict[str, Any]:
        raw = self.metadata.get("defaults", {})
        return raw if isinstance(raw, dict) else {}

    def resolve_model_file(self) -> Optional[Path]:
        if isinstance(self.metadata.get("model"), str):
            p = self.root / self.metadata["model"]
            if p.exists():
                return p

        candidates = sorted(self.root.glob("*.gguf"))
        candidates = [p for p in candidates if "mmproj" not in p.name.lower()]
        if not candidates:
            return None

        split_first = [p for p in candidates if re.search(r"00001-of-\d+", p.name, re.I)]
        if split_first:
            return split_first[0]

        if len(candidates) == 1:
            return candidates[0]

        candidates.sort(key=lambda p: (len(p.name), p.name.lower()))
        return candidates[0]

    def resolve_model_path(self) -> Optional[Path]:
        """Resolve either a GGUF file or an MLX model directory."""
        if isinstance(self.metadata.get("model"), str):
            p = (self.root / self.metadata["model"]).expanduser()
            if p.exists():
                return p
        return self.resolve_model_file()

    def resolve_mlx_draft_path(self) -> Optional[Path]:
        """Resolve an MLX speculative drafter/MTP directory."""
        for key in ("draft_model", "mtp", "mlx_draft_model"):
            raw = self.metadata.get(key)
            if isinstance(raw, str) and raw.strip():
                p = (self.root / raw).expanduser()
                if p.exists():
                    return p
        for name in ("mtp", "MTP", "draft", "drafter"):
            p = self.root / name
            if p.is_dir():
                return p
        return None

    def resolve_mmproj_file(self) -> Optional[Path]:
        if isinstance(self.metadata.get("mmproj"), str):
            p = self.root / self.metadata["mmproj"]
            if p.exists():
                return p
        candidates = sorted(self.root.glob("*mmproj*.gguf"))
        return candidates[0] if candidates else None

    def resolve_mtp_file(self) -> Optional[Path]:
        # Optional external MTP draft GGUF.  By convention keep it under
        # <model>/MTP/ and start the filename with "mtp-".
        mtp_dir = self.root / "MTP"
        if not mtp_dir.is_dir():
            return None

        candidates = sorted(
            p for p in mtp_dir.glob("*.gguf")
            if p.name.lower().startswith("mtp-")
        )
        if not candidates:
            return None
        if len(candidates) > 1:
            names = ", ".join(p.name for p in candidates)
            raise SystemExit(
                f"Multiple MTP draft GGUF files found in {mtp_dir}: {names}. "
                "Keep only one mtp-*.gguf file there."
            )
        return candidates[0]


def load_model_metadata(model_dir: Path) -> Tuple[Optional[Path], Dict[str, Any]]:
    for fname in METADATA_FILES:
        p = model_dir / fname
        if p.exists():
            return p, load_jsonc(p)
    return None, {}


def discover_models(models_dir: Path) -> List[ModelEntry]:
    entries: List[ModelEntry] = []
    if not models_dir.exists():
        return entries
    for pub in sorted(p for p in models_dir.iterdir() if p.is_dir()):
        for model in sorted(p for p in pub.iterdir() if p.is_dir()):
            metadata_path, metadata = load_model_metadata(model)
            entries.append(ModelEntry(pub.name, model.name, model, metadata_path, metadata))
    return entries


# -----------------------------
# Rule matching / resolution
# -----------------------------

def text_for_matching(entry: ModelEntry) -> str:
    bits = [
        entry.model_id,
        entry.name,
        entry.publisher,
        " ".join(entry.aliases),
        " ".join(entry.tags),
        str(entry.metadata.get("notes", "")),
    ]
    return " ".join(bits).lower()


def regex_search(pattern: str, text: str) -> bool:
    try:
        return re.search(pattern, text, re.I) is not None
    except re.error:
        return pattern.lower() in text.lower()


def build_alias_map(config: Dict[str, Any], models: List[ModelEntry]) -> Dict[str, str]:
    alias_map: Dict[str, str] = {}
    for k, v in (config.get("aliases") or {}).items():
        alias_map[str(k)] = str(v)
    for m in models:
        for alias in m.aliases:
            alias_map.setdefault(alias, m.model_id)
    return alias_map

def get_running_models(models: List[ModelEntry]) -> List[ModelEntry]:
    running: List[ModelEntry] = []
    by_id = {m.model_id: m for m in models}

    for sf in sorted(RUN_DIR.glob("slot-*.json")):
        st = load_state(sf)
        if not st:
            continue
        pid = int(st.get("pid", -1))
        if pid_alive(pid):
            model_id = str(st.get("model_id", ""))
            m = by_id.get(model_id)
            if m is not None and all(x.model_id != m.model_id for x in running):
                running.append(m)
        else:
            sf.unlink(missing_ok=True)

    # backward compatibility with the old per-model state files
    for m in models:
        sf = state_file_for(m)
        st = load_state(sf)
        if not st:
            continue
        pid = int(st.get("pid", -1))
        if pid_alive(pid):
            if all(x.model_id != m.model_id for x in running):
                running.append(m)
        else:
            sf.unlink(missing_ok=True)

    return running

def resolve_model(query: Optional[str], config: Dict[str, Any], models: List[ModelEntry]) -> ModelEntry:
    if not models:
        raise SystemExit("No models found.")

    if not query:
        chosen = run_fzf_model_picker(models)
        if not chosen:
            raise SystemExit(1)
        query = chosen

    alias_map = build_alias_map(config, models)
    query = alias_map.get(query, query)

    by_id = {m.model_id: m for m in models}
    if query in by_id:
        return by_id[query]

    lowered = query.lower()

    exactish = [m for m in models if lowered == m.name.lower() or lowered == m.model_id.lower()]
    if len(exactish) == 1:
        return exactish[0]

    alias_hits = [m for m in models if lowered in [a.lower() for a in m.aliases]]
    if len(alias_hits) == 1:
        return alias_hits[0]

    partial = [m for m in models if lowered in m.model_id.lower() or lowered in m.name.lower()]
    if len(partial) == 1:
        return partial[0]
    if len(partial) > 1:
        print("Multiple models matched:", file=sys.stderr)
        for m in partial:
            print(f"  - {m.model_id}", file=sys.stderr)
        raise SystemExit(2)

    raise SystemExit(f"Model not found: {query}")


def matched_rules(entry: ModelEntry, config: Dict[str, Any]) -> List[Dict[str, Any]]:
    rules = config.get("model_rules") or []
    text = text_for_matching(entry)
    out = []
    for rule in rules:
        pattern = str(rule.get("match", "")).strip()
        if not pattern:
            continue
        if regex_search(pattern, text):
            out.append(rule)
    return out


def effective_config(
    entry: ModelEntry,
    config: Dict[str, Any],
    cli_override: Optional[Dict[str, Any]] = None,
) -> Tuple[Dict[str, Any], List[str], List[Dict[str, Any]]]:
    cur = deep_copy_dict(BUILTIN_DEFAULTS)
    cur = merge_config(cur, entry.defaults)
    cur = merge_config(cur, config.get("defaults") or {})

    profile_names: List[str] = []
    rules = matched_rules(entry, config)
    profiles = config.get("profiles") or {}

    for rule in rules:
        for profile_name in rule.get("use_profiles", []) or []:
            profile = profiles.get(profile_name)
            if profile:
                cur = merge_config(cur, profile)
                profile_names.append(profile_name)

    for rule in rules:
        cur = merge_config(cur, rule.get("override") or {})

    cur = merge_config(cur, cli_override or {})
    return cur, profile_names, rules


# -----------------------------
# Command construction
# -----------------------------

def flagify_extra(extra_args: Iterable[Any]) -> List[str]:
    return [str(x) for x in extra_args]


def build_backend_command(entry: ModelEntry, cfg: Dict[str, Any]) -> List[str]:
    backend_raw = str(entry.metadata.get("backend") or cfg.get("backend") or "llama-server")
    backend_key = backend_raw.strip().lower()

    is_mtplx = backend_key in {"mtplx"}

    if is_mtplx:
        backend_bin = (
            cfg.get("backend_bin")
            or cfg.get("mtplx_bin")
            or entry.metadata.get("backend_bin")
            or entry.metadata.get("mtplx_bin")
            or "mtplx"
        )

        model_id = entry.metadata.get("model")
        if not isinstance(model_id, str) or not model_id.strip():
            raise SystemExit(
                'MTPLX requires a model ID in metadata, for example: '
                '"model": "Youssofal/Qwen3.8-27B-MTPLX-Bare-Speed"'
            )

        cmd = [str(backend_bin), "serve", "--model", model_id.strip()]

        def add_mtplx_opt(key: str, flag: str):
            val = cfg.get(key)
            if val is None:
                return
            if isinstance(val, bool):
                if val:
                    cmd.append(flag)
            else:
                cmd.extend([flag, str(val)])

        add_mtplx_opt("host", "--host")
        add_mtplx_opt("port", "--port")
        add_mtplx_opt("mtplx_context", "--context-window")
        add_mtplx_opt("mtplx_paged_kv_quantization", "--paged-kv-quantization")
        add_mtplx_opt("mtplx_temperature", "--temperature")
        add_mtplx_opt("mtplx_top_p", "--top-p")
        add_mtplx_opt("mtplx_top_k", "--top-k")
        add_mtplx_opt("mtplx_api_key", "--api-key")

        cmd.extend(flagify_extra(cfg.get("mtplx_extra_args", [])))
        return cmd

    is_omlx = backend_key in {"omlx", "omlx-server", "omlx.server"}

    if is_omlx:
        # oMLX discovers models from --model-dir instead of accepting one
        # --model argument.  Preserve lls's single-selected-model semantics by
        # creating a tiny staging model-dir that contains exactly one symlink
        # to the selected MLX model.  /v1/models therefore exposes only that
        # selected model to OpenCode.
        backend_bin = (
            cfg.get("backend_bin")
            or cfg.get("omlx_bin")
            or entry.metadata.get("backend_bin")
            or entry.metadata.get("omlx_bin")
            or "omlx"
        )

        raw_model = entry.metadata.get("model")
        if isinstance(raw_model, str) and raw_model.strip():
            model_path = (entry.root / raw_model).expanduser().resolve()
        else:
            model_path = entry.root.resolve()

        if not model_path.is_dir():
            raise SystemExit(
                f"oMLX requires an MLX-format model directory, not a GGUF file: {model_path}"
            )

        # By default expose the real model directory name.  omlx_model_id can
        # optionally override the API-visible ID used by OpenCode.  A slash is
        # allowed (publisher/model); absolute paths and '..' are rejected.
        api_model_id = str(
            entry.metadata.get("omlx_model_id")
            or cfg.get("omlx_model_id")
            or model_path.name
        ).strip()
        if not api_model_id:
            raise SystemExit("omlx_model_id cannot be empty")
        api_rel = Path(api_model_id)
        if api_rel.is_absolute() or ".." in api_rel.parts:
            raise SystemExit(
                f"Invalid oMLX model ID {api_model_id!r}: use a relative model name"
            )

        staging_root = STATE_DIR / "omlx-models" / slugify(entry.model_id)
        staging_root.mkdir(parents=True, exist_ok=True)

        # This staging root belongs only to this LLS model entry, so remove any
        # stale links/directories left by an older omlx_model_id.
        for child in list(staging_root.iterdir()):
            if child.is_symlink() or child.is_file():
                child.unlink()
            elif child.is_dir():
                import shutil
                shutil.rmtree(child)

        link_path = staging_root / api_rel
        link_path.parent.mkdir(parents=True, exist_ok=True)
        link_path.symlink_to(model_path, target_is_directory=True)

        cmd = [str(backend_bin), "serve", "--model-dir", str(staging_root)]

        def add_omlx_opt(key: str, flag: str):
            val = cfg.get(key)
            if val is None:
                return
            if isinstance(val, bool):
                if val:
                    cmd.append(flag)
            else:
                cmd.extend([flag, str(val)])

        add_omlx_opt("host", "--host")
        add_omlx_opt("port", "--port")
        add_omlx_opt("omlx_memory_guard", "--memory-guard")
        add_omlx_opt("omlx_memory_guard_gb", "--memory-guard-gb")
        add_omlx_opt("omlx_paged_ssd_cache_dir", "--paged-ssd-cache-dir")
        add_omlx_opt("omlx_hot_cache_max_size", "--hot-cache-max-size")
        add_omlx_opt("omlx_max_concurrent_requests", "--max-concurrent-requests")
        add_omlx_opt("omlx_api_key", "--api-key")
        add_omlx_opt("omlx_log_level", "--log-level")

        cmd.extend(flagify_extra(cfg.get("omlx_extra_args", [])))
        return cmd

    is_mlx = backend_key in {
        "mlx-vlm", "mlx_vlm", "mlx-vlm-server", "mlx_vlm.server"
    }

    if is_mlx:
        model_path = entry.resolve_model_path()
        if not model_path:
            raise SystemExit(
                f"No MLX model path found in {entry.root}. "
                'Set metadata "model" to the MLX model directory (for example "4-bit").'
            )

        backend_bin = (
            cfg.get("backend_bin")
            or cfg.get("mlx_vlm_server_bin")
            or entry.metadata.get("backend_bin")
            or entry.metadata.get("mlx_vlm_server_bin")
            or "mlx_vlm.server"
        )
        cmd = [str(backend_bin), "--model", str(model_path)]

        def add_mlx_opt(key: str, flag: str):
            val = cfg.get(key)
            if val is None:
                return
            if isinstance(val, bool):
                if val:
                    cmd.append(flag)
            else:
                cmd.extend([flag, str(val)])

        add_mlx_opt("host", "--host")
        add_mlx_opt("port", "--port")
        add_mlx_opt("ctx", "--max-kv-size")
        add_mlx_opt("mlx_prefill_step_size", "--prefill-step-size")
        add_mlx_opt("mlx_kv_bits", "--kv-bits")
        add_mlx_opt("mlx_kv_quant_scheme", "--kv-quant-scheme")
        add_mlx_opt("mlx_kv_group_size", "--kv-group-size")
        add_mlx_opt("mlx_quantized_kv_start", "--quantized-kv-start")
        add_mlx_opt("mlx_vision_cache_size", "--vision-cache-size")
        add_mlx_opt("mlx_log_level", "--log-level")
        add_mlx_opt("mlx_enable_thinking", "--enable-thinking")
        add_mlx_opt("mlx_trust_remote_code", "--trust-remote-code")
        add_mlx_opt("mlx_reload", "--reload")

        draft = entry.resolve_mlx_draft_path()
        draft_enabled = cfg.get("mlx_mtp", cfg.get("mtp", True))
        if draft and draft_enabled:
            cmd.extend(["--draft-model", str(draft)])
            draft_kind = cfg.get("mlx_draft_kind")
            if draft_kind is None and draft.name.lower() == "mtp":
                draft_kind = "mtp"
            if draft_kind:
                cmd.extend(["--draft-kind", str(draft_kind)])
            block_size = cfg.get("mlx_draft_block_size")
            if block_size is not None:
                cmd.extend(["--draft-block-size", str(block_size)])

        # Do not reuse legacy flag_* here; those are llama-server flags.
        cmd.extend(flagify_extra(cfg.get("mlx_extra_args", [])))
        return cmd

    # llama.cpp / llama-server compatible backend (existing behavior).
    model_file = entry.resolve_model_file()
    if not model_file:
        raise SystemExit(f"No model gguf found in {entry.root}")

    backend_bin = cfg.get("backend_bin") or cfg.get("llama_server_bin") or backend_raw
    cmd = [str(backend_bin)]

    def add_opt(key: str, flag: str):
        val = cfg.get(key)
        if val is None:
            return
        cmd.extend([flag, str(val)])

    cmd.extend(["--model", str(model_file)])
    add_opt("host", "--host")
    add_opt("port", "--port")
    add_opt("ctx", "--ctx-size")
    add_opt("threads", "--threads")
    add_opt("batch", "--batch-size")
    add_opt("ubatch", "--ubatch-size")
    add_opt("gpu_layers", "--n-gpu-layers")

    mmproj = None if cfg.get("no_mmproj") else entry.resolve_mmproj_file()
    if mmproj:
        cmd.extend(["--mmproj", str(mmproj)])

    spec_type = str(cfg.get("flag_spec_type", "")).lower()
    explicit_draft = cfg.get("flag_spec_draft_model") or cfg.get("flag_model_draft")
    if "draft-mtp" in {x.strip() for x in spec_type.split(",")} and not explicit_draft:
        mtp_file = entry.resolve_mtp_file()
        if mtp_file:
            cmd.extend(["--spec-draft-model", str(mtp_file)])

    for key, val in list(cfg.items()):
        if not key.startswith("flag_"):
            continue
        flag = "--" + key[5:].replace("_", "-")
        if isinstance(val, bool):
            if val:
                cmd.append(flag)
        else:
            cmd.extend([flag, str(val)])

    cmd.extend(flagify_extra(cfg.get("extra_args", [])))
    return cmd


# -----------------------------
# Process state helpers
# -----------------------------

def ensure_state_dir() -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    RUN_DIR.mkdir(parents=True, exist_ok=True)


def state_file_for(entry: ModelEntry) -> Path:
    return RUN_DIR / f"{slugify(entry.model_id)}.json"


def log_file_for(entry: ModelEntry) -> Path:
    return LOG_DIR / f"{slugify(entry.model_id)}.log"


def state_file_for_slot(slot: int) -> Path:
    return RUN_DIR / f"slot-{slot}.json"


def parse_start_slot_and_model(args: argparse.Namespace) -> Tuple[int, Optional[str]]:
    first = getattr(args, "slot_or_model", None)
    second = getattr(args, "model", None)

    slot = 1
    model_query: Optional[str] = None

    if first:
        if str(first).isdigit():
            slot = int(first)
            if slot < 1:
                raise SystemExit("slot must be >= 1")
            model_query = second
        else:
            model_query = first
            if second is not None:
                raise SystemExit("Too many positional arguments for start")
    elif second is not None:
        raise SystemExit("Invalid start arguments")

    return slot, model_query


def rotate_log_file(path: Path, keep: int = DEFAULT_LOG_ROTATIONS) -> None:
    if keep < 1:
        keep = 1
    oldest = path.with_name(f"{path.name}.{keep}")
    if oldest.exists():
        oldest.unlink()
    for i in range(keep - 1, 0, -1):
        src = path.with_name(f"{path.name}.{i}")
        dst = path.with_name(f"{path.name}.{i + 1}")
        if src.exists():
            src.rename(dst)
    if path.exists() and path.stat().st_size > 0:
        path.rename(path.with_name(f"{path.name}.1"))


def pid_alive(pid: int) -> bool:
    """Return True only for a genuinely live (non-zombie) process."""
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False

    # kill(pid, 0) also succeeds for zombies.  Treat those as stopped so
    # stale slot state does not continue to show as "running".
    try:
        out = subprocess.run(
            ["ps", "-o", "stat=", "-p", str(pid)],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=1.0,
            check=False,
        ).stdout.strip()
        if not out:
            return False
        if out.startswith("Z"):
            return False
    except Exception:
        # If ps is unavailable, fall back to the portable kill(0) result.
        pass
    return True


def _signal_process(pid: int, sig: int) -> None:
    """Signal the whole server process group when possible.

    cmd_start() uses start_new_session=True, so the llama-server PID is also
    the process-group leader.  Killing the group prevents helper/child
    processes from being left behind.
    """
    if os.name == "posix":
        try:
            os.killpg(pid, sig)
            return
        except (ProcessLookupError, PermissionError):
            pass
        except OSError:
            pass
    os.kill(pid, sig)


def _wait_pid_exit(pid: int, timeout: float) -> bool:
    deadline = time.monotonic() + max(0.0, timeout)
    while time.monotonic() < deadline:
        if not pid_alive(pid):
            return True
        time.sleep(0.10)
    return not pid_alive(pid)


def load_state(path: Path) -> Optional[Dict[str, Any]]:
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None


def save_state(path: Path, data: Dict[str, Any]) -> None:
    path.write_text(json.dumps(data, indent=2), encoding="utf-8")


def set_active(entry: ModelEntry) -> None:
    save_state(ACTIVE_FILE, {"model_id": entry.model_id})


def get_active_model_id() -> Optional[str]:
    st = load_state(ACTIVE_FILE)
    if st:
        return st.get("model_id")
    return None


def clear_active_if(entry: ModelEntry) -> None:
    active = get_active_model_id()
    if active == entry.model_id and ACTIVE_FILE.exists():
        ACTIVE_FILE.unlink()


# -----------------------------
# fzf helpers
# -----------------------------

def have_cmd(name: str) -> bool:
    from shutil import which
    return which(name) is not None


def run_fzf(lines: List[str], prompt: str = "model> ") -> Optional[str]:
    if not lines:
        return None
    if not have_cmd("fzf"):
        return lines[0]
    proc = subprocess.run(
        ["fzf", "--prompt", prompt, "--height", "80%", "--layout", "reverse", "--border"],
        input="\n".join(lines),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    if proc.returncode != 0:
        return None
    return proc.stdout.strip() or None


def run_fzf_model_picker(models: List[ModelEntry]) -> Optional[str]:
    lines = []
    for m in models:
        tags = f" [{', '.join(m.tags)}]" if m.tags else ""
        aliases = f" ({', '.join(m.aliases)})" if m.aliases else ""
        lines.append(f"{m.model_id}{aliases}{tags}")
    picked = run_fzf(lines)
    if not picked:
        return None
    return picked.split(" (")[0].split(" [")[0]


def run_action_picker() -> Optional[str]:
    return run_fzf([
        "start",
        "stop",
        "status",
        "log",
        "show-profile",
        "pick",
    ], prompt="action> ")


# -----------------------------
# Presentation helpers
# -----------------------------

def format_kv_table(items: List[Tuple[str, Any]]) -> str:
    width = max((len(k) for k, _ in items), default=0)
    return "\n".join(f"{k:<{width}} : {v}" for k, v in items)


def pretty_cmd(cmd: List[str]) -> str:
    return " ".join(shlex.quote(x) for x in cmd)


def rule_label(rule: Dict[str, Any]) -> str:
    name = rule.get("name")
    match = rule.get("match")
    if name:
        return f"{name} ({match})"
    return str(match)


# -----------------------------
# Subcommands
# -----------------------------

def cmd_list(args: argparse.Namespace, config: Dict[str, Any], models: List[ModelEntry]) -> int:
    if args.ids:
        for m in models:
            print(m.model_id)
        return 0
    for m in models:
        print(m.model_id)
    return 0


def cmd_pick(args: argparse.Namespace, config: Dict[str, Any], models: List[ModelEntry]) -> int:
    picked = run_fzf_model_picker(models)
    if picked:
        print(picked)
        return 0
    return 1


def cmd_show_profile(args: argparse.Namespace, config: Dict[str, Any], models: List[ModelEntry]) -> int:
    entry = resolve_model(args.model, config, models)
    cli_override: Dict[str, Any] = {}
    if args.port is not None:
        cli_override["port"] = args.port
    cfg, profile_names, rules = effective_config(entry, config, cli_override)
    cmd = build_backend_command(entry, cfg)
    model_file = entry.resolve_model_path()
    mmproj = entry.resolve_mmproj_file()
    mlx_draft = entry.resolve_mlx_draft_path()

    info = [
        ("Requested", args.model or "<picker>"),
        ("Resolved ID", entry.model_id),
        ("Model dir", str(entry.root)),
        ("Model file", model_file.name if model_file else "<missing>"),
        ("MMProj", mmproj.name if mmproj else "-"),
        ("MLX draft", str(mlx_draft) if mlx_draft else "-"),
        ("Metadata", str(entry.metadata_path) if entry.metadata_path else "-"),
        ("Aliases", ", ".join(entry.aliases) if entry.aliases else "-"),
        ("Tags", ", ".join(entry.tags) if entry.tags else "-"),
        ("Applied profiles", ", ".join(profile_names) if profile_names else "-"),
        ("Matched rules", ", ".join(rule_label(r) for r in rules) if rules else "-"),
        ("Backend", entry.metadata.get("backend") or cfg.get("backend")),
        ("oMLX API model ID", entry.metadata.get("omlx_model_id") or cfg.get("omlx_model_id") or entry.name),
        ("Host", cfg.get("host")),
        ("Port", cfg.get("port")),
        ("Ctx", cfg.get("ctx")),
        ("Threads", cfg.get("threads")),
        ("Batch", cfg.get("batch")),
        ("UBatch", cfg.get("ubatch")),
        ("GPU layers", cfg.get("gpu_layers")),
    ]
    print(format_kv_table(info))

    extra_args = cfg.get("extra_args", []) or []
    print("\nExtra args:")
    if extra_args:
        for a in extra_args:
            print(f"  {a}")
    else:
        print("  -")

    print("\nCommand:")
    print(pretty_cmd(cmd))
    return 0


def cmd_start(args: argparse.Namespace, config: Dict[str, Any], models: List[ModelEntry]) -> int:
    ensure_state_dir()

    slot, model_query = parse_start_slot_and_model(args)
    entry = resolve_model(model_query, config, models)
    state_path = state_file_for_slot(slot)
    existing = load_state(state_path)
    if existing and pid_alive(int(existing.get("pid", -1))):
        existing_model = existing.get("model_id", "<unknown>")
        print(f"Slot {slot} already running: {existing_model} (pid {existing['pid']})")
        if existing_model == entry.model_id:
            set_active(entry)
        return 1

    cli_override: Dict[str, Any] = {}
    base_port = int(config.get("base_port", BUILTIN_DEFAULTS.get("port", 8080)))
    port_for_slot = base_port + (slot - 1)

    cli_override["port"] = port_for_slot
    if args.port is not None:
        cli_override["port"] = args.port
    if args.ctx is not None:
        cli_override["ctx"] = args.ctx
    cfg, profile_names, rules = effective_config(entry, config, cli_override)
    cmd = build_backend_command(entry, cfg)

    rotations = int(config.get("log_rotations", DEFAULT_LOG_ROTATIONS))
    log_path = log_file_for(entry) if slot == 1 else LOG_DIR / f"{slugify(entry.model_id)}.slot-{slot}.log"
    rotate_log_file(log_path, rotations)
    log_f = open(log_path, "ab")

    proc = subprocess.Popen(
        cmd,
        stdout=log_f,
        stderr=subprocess.STDOUT,
        cwd=str(entry.root),
        start_new_session=True,
    )

    save_state(state_path, {
        "model_id": entry.model_id,
        "slot": slot,
        "port": cfg.get("port"),
        "pid": proc.pid,
        "started_at": int(time.time()),
        "cwd": str(entry.root),
        "cmd": cmd,
        "log": str(log_path),
        "profiles": profile_names,
        "rules": [rule_label(r) for r in rules],
    })
    set_active(entry)

    print(f"Started: {entry.model_id}")
    print(f"Slot   : {slot}")
    print(f"Port   : {cfg.get('port')}")
    print(f"PID    : {proc.pid}")
    print(f"Log    : {log_path}")
    print(f"Cmd    : {pretty_cmd(cmd)}")

    if not args.detach:
        try:
            return cmd_log(
                argparse.Namespace(model=entry.model_id, follow=True, lines=args.lines),
                config,
                models,
            )
        except KeyboardInterrupt:
            return 130
    return 0

def find_running_slot_states() -> List[Dict[str, Any]]:
    rows: List[Dict[str, Any]] = []
    for sf in sorted(RUN_DIR.glob("slot-*.json")):
        st = load_state(sf)
        if not st:
            continue
        pid = int(st.get("pid", -1))
        if not pid_alive(pid):
            sf.unlink(missing_ok=True)
            continue
        row = dict(st)
        row["_path"] = str(sf)
        rows.append(row)
    return rows


def pick_running_slot_state(config: Dict[str, Any], models: List[ModelEntry]) -> Optional[Dict[str, Any]]:
    rows = find_running_slot_states()
    if not rows:
        return None
    if len(rows) == 1:
        return rows[0]

    lines: List[str] = []
    for st in rows:
        slot = int(st.get("slot", 1))
        port = int(st.get("port", config.get("base_port", BUILTIN_DEFAULTS.get("port", 8080)) + (slot - 1)))
        model_id = str(st.get("model_id", ""))
        pid = str(st.get("pid", "-"))
        lines.append(f"slot={slot}\tport={port}\tpid={pid}\t{model_id}")

    picked = run_fzf(lines, prompt="running> ")
    if not picked:
        return None
    m = re.search(r"slot=(\d+)", picked)
    if not m:
        return None
    wanted_slot = int(m.group(1))
    for st in rows:
        if int(st.get("slot", 1)) == wanted_slot:
            return st
    return None


def _stop_state_file(state_path: Path, force: bool = False) -> Tuple[bool, str]:
    st = load_state(state_path)
    if not st:
        return False, f"No state: {state_path.name}"

    pid = int(st.get("pid", -1))
    if pid <= 0:
        state_path.unlink(missing_ok=True)
        return False, f"Invalid pid in {state_path.name}"

    if not pid_alive(pid):
        state_path.unlink(missing_ok=True)
        return False, f"Already dead: pid {pid} (state cleaned)"

    # --force means immediate SIGKILL.  Normal stop first gives llama-server
    # time to shut down cleanly, then escalates only if it refuses to exit.
    if force:
        try:
            _signal_process(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        exited = _wait_pid_exit(pid, 2.0)
        if exited:
            state_path.unlink(missing_ok=True)
            return True, f"Stopped pid {pid} (SIGKILL)"
        return False, f"Failed to stop pid {pid}"

    try:
        _signal_process(pid, signal.SIGTERM)
    except ProcessLookupError:
        state_path.unlink(missing_ok=True)
        return True, f"Stopped pid {pid}"

    if _wait_pid_exit(pid, 10.0):
        state_path.unlink(missing_ok=True)
        return True, f"Stopped pid {pid}"

    # Do not print a false success. Escalate after the grace period.
    try:
        _signal_process(pid, signal.SIGKILL)
    except ProcessLookupError:
        state_path.unlink(missing_ok=True)
        return True, f"Stopped pid {pid}"

    if _wait_pid_exit(pid, 2.0):
        state_path.unlink(missing_ok=True)
        return True, f"Stopped pid {pid} (SIGTERM timeout; SIGKILL)"

    return False, f"Failed to stop pid {pid} after SIGTERM/SIGKILL"


def cmd_stop(args: argparse.Namespace, config: Dict[str, Any], models: List[ModelEntry]) -> int:
    ensure_state_dir()
    if args.all:
        any_stopped = False
        for p in sorted(RUN_DIR.glob("*.json")):
            ok, msg = _stop_state_file(p, force=args.force)
            print(f"{p.name}: {msg}")
            any_stopped = any_stopped or ok
        if ACTIVE_FILE.exists():
            ACTIVE_FILE.unlink()
        return 0 if any_stopped else 1

    if args.active:
        active = get_active_model_id()
        if not active:
            print("No active model")
            return 1
        entry = resolve_model(active, config, models)
        chosen_state: Optional[Dict[str, Any]] = None
        for st in find_running_slot_states():
            if st.get("model_id") == entry.model_id:
                chosen_state = st
                break
        state_path = Path(chosen_state["_path"]) if chosen_state else state_file_for(entry)
        ok, msg = _stop_state_file(state_path, force=args.force)
        print(f"{entry.model_id}: {msg}")
        if state_path.exists() and not pid_alive(int((load_state(state_path) or {}).get("pid", -1))):
            state_path.unlink(missing_ok=True)
        clear_active_if(entry)
        return 0 if ok else 1

    if not args.model:
        chosen_state = pick_running_slot_state(config, models)
        if not chosen_state:
            print("No running models")
            return 1
        state_path = Path(str(chosen_state["_path"]))
        model_id = str(chosen_state.get("model_id", "<unknown>"))
        entry = resolve_model(model_id, config, models)
        ok, msg = _stop_state_file(state_path, force=args.force)
        slot = chosen_state.get("slot", "?")
        print(f"slot {slot} {entry.model_id}: {msg}")
        if state_path.exists() and not pid_alive(int((load_state(state_path) or {}).get("pid", -1))):
            state_path.unlink(missing_ok=True)
        clear_active_if(entry)
        return 0 if ok else 1

    entry = resolve_model(args.model, config, models)
    matching_states = [st for st in find_running_slot_states() if st.get("model_id") == entry.model_id]
    if len(matching_states) == 1:
        state_path = Path(str(matching_states[0]["_path"]))
    elif len(matching_states) > 1:
        lines: List[str] = []
        for st in matching_states:
            slot = int(st.get("slot", 1))
            port = int(st.get("port", config.get("base_port", BUILTIN_DEFAULTS.get("port", 8080)) + (slot - 1)))
            pid = str(st.get("pid", "-"))
            lines.append(f"slot={slot}\tport={port}\tpid={pid}\t{entry.model_id}")
        picked = run_fzf(lines, prompt="stop-slot> ")
        if not picked:
            return 1
        m = re.search(r"slot=(\d+)", picked)
        if not m:
            return 1
        wanted_slot = int(m.group(1))
        chosen = next((st for st in matching_states if int(st.get("slot", 1)) == wanted_slot), None)
        if not chosen:
            return 1
        state_path = Path(str(chosen["_path"]))
    else:
        state_path = state_file_for(entry)

    ok, msg = _stop_state_file(state_path, force=args.force)
    print(f"{entry.model_id}: {msg}")
    if state_path.exists() and not pid_alive(int((load_state(state_path) or {}).get("pid", -1))):
        state_path.unlink(missing_ok=True)
    clear_active_if(entry)
    return 0 if ok else 1

